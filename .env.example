# ---------------------------------------------------------------
# Contact form (Server Action in src/app/actions/contact.ts)
# Copy this file to .env.local and fill in the values.
# Without RESEND_API_KEY the form still validates, but tells the
# visitor it is not configured and offers a mailto link instead.
# ---------------------------------------------------------------

# Required to actually deliver mail. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to the email in src/lib/data.ts
CONTACT_TO_EMAIL=

# Sender address. The default works without verifying a domain, but can only
# deliver to the address that owns the Resend account. Once you verify your own
# domain, change this to something like "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: override the provider endpoint (used for local testing/mocks).
# RESEND_API_URL=https://api.resend.com/emails
